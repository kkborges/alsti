# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Language Compilers and Interpreters Paths
# Python
PYTHON_PATH=/usr/bin/python3
PIP_PATH=/usr/bin/pip3

# Node.js
NODE_PATH=/usr/bin/node
NPM_PATH=/usr/bin/npm
NPX_PATH=/usr/bin/npx

# Java
JAVA_PATH=/usr/bin/java
JAVAC_PATH=/usr/bin/javac
MAVEN_PATH=/usr/bin/mvn
GRADLE_PATH=/usr/bin/gradle

# .NET
DOTNET_PATH=/usr/bin/dotnet

# PHP
PHP_PATH=/usr/bin/php
COMPOSER_PATH=/usr/bin/composer

# Go
GO_PATH=/usr/bin/go

# Rust
CARGO_PATH=/usr/bin/cargo
RUSTC_PATH=/usr/bin/rustc

# Ruby
RUBY_PATH=/usr/bin/ruby
GEM_PATH=/usr/bin/gem
BUNDLE_PATH=/usr/bin/bundle

# Output Configuration
GENERATED_CODE_DIR=./generated
MAX_RETRY_ATTEMPTS=5
VALIDATION_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=./gemini-code-generator.log
